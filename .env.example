# === Supabase (app runtime) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Service role key — bypasses RLS. Required in production for:
#   • POST /api/reviews/submit (public review form proxy)
#   • POST /api/leads (lead capture insert)
#   • POST /api/webhook/telegram (approve/reject from Telegram)
#   • /admin/login (verify user is in admin_users)
# NOT valid for SQL migrations — use DATABASE_URL or SUPABASE_ACCESS_TOKEN below.
SUPABASE_SERVICE_KEY=your-service-role-key

# === DB migrations (scripts/deploy-db.mjs) ===
# Service key does NOT run SQL migrations. Use one of:

# Option 1 (recommended if you lack the database password):
# Owner: https://supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# Option 2: Postgres password
# SUPABASE_DB_PASSWORD=your-database-password
# On Vercel, pooler is almost always required:
# SUPABASE_DB_REGION=eu-central-1

# Option 3: full connection URI (also used by scripts/backup-db.mjs)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# First admin (bootstrap via deploy-db.mjs — Auth Admin API + service key)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# === Newsletter (Resend) ===
# https://resend.com/api-keys — verified sending domain required for RESEND_FROM_EMAIL
# Used by admin newsletter test send (POST /api/admin/newsletter/send-test)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Triplandr <hello@triplandr.com>

# === Telegram (optional — leads + review moderation) ===
# Create bot: https://t.me/BotFather → /newbot
# Admin chat ID: message @userinfobot or add bot to a group and read updates
# Leads: POST /api/leads sends a Telegram message when both vars are set
# Reviews: configure Supabase Database Webhook (see SUPABASE_WEBHOOK_SECRET) +
#   set bot webhook to https://YOUR_DOMAIN/api/webhook/telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Shared secret for Supabase Database Webhook → POST /api/webhook/review
# (INSERT on reviews table). Must match the header x-webhook-secret in Supabase.
SUPABASE_WEBHOOK_SECRET=

# HMAC secret for anonymous review claim tokens (POST /api/reviews/claim)
REVIEW_CLAIM_SECRET=

# === Reader auth (Supabase Dashboard) ===
# Enable Email magic link + Google OAuth provider.
# Redirect URLs: https://triplandr.com/auth/callback, http://localhost:3000/auth/callback
# Site URL: https://triplandr.com

# === Analytics (Plausible) ===
# Site domain as registered in Plausible dashboard, e.g. triplandr.com
# Leave empty to disable the script (app/plugins/plausible.client.ts)
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=triplandr.com

# === Error monitoring (optional) ===
# Client-side Vue/app errors only — leave empty to disable (app/plugins/sentry.client.ts)
NUXT_PUBLIC_SENTRY_DSN=

# === DB backups (scripts/backup-db.mjs, .github/workflows/backup-db.yml) ===
# Uses same DB credentials as migrations (DATABASE_URL or SUPABASE_DB_PASSWORD + SUPABASE_URL)
# BACKUP_DIR=./backups
# BACKUP_INCLUDE_AUTH=1
# BACKUP_DELETE_LOCAL=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=auto
# AWS_ENDPOINT_URL=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# AWS_S3_PREFIX=triplandr/backups/
