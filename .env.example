SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# === DB migrations (scripts/deploy-db.mjs) ===
# Service key НЕ подходит для SQL-миграций. Нужен один из вариантов:

# Вариант 1 (рекомендуется без доступа к Database password):
# Owner: https://supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# Вариант 2: пароль Postgres
# SUPABASE_DB_PASSWORD=your-database-password
# На Vercel почти всегда нужен pooler:
# SUPABASE_DB_REGION=eu-central-1

# Вариант 3: полный URI
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Первый админ (через service key + Auth Admin API)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SUPABASE_WEBHOOK_SECRET=
