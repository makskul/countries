SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- DB migrations (deploy-db.mjs) — нужен пароль Postgres, НЕ service key ---
# Вариант A: полный URI (если уже есть)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Вариант B: только пароль — URI соберётся из SUPABASE_URL автоматически
SUPABASE_DB_PASSWORD=your-database-password

# Вариант C: через pooler (если direct :5432 недоступен с Vercel/CI)
# SUPABASE_DB_REGION=eu-central-1

# Первый админ создаётся автоматически при деплое (через service key, без Dashboard)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SUPABASE_WEBHOOK_SECRET=
